# 로컬 전용 예시입니다. 실제 값이 들어간 .env 파일은 Git에 포함되지 않습니다.
DATA_GO_KR_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
G2B_BASE_URL=

# Bidpage 수집을 사용할 때만 true로 설정합니다.
BIDPAGE_ENABLED=false
BIDPAGE_BASE_URL=https://guro.bidpage.co.kr
BIDPAGE_PAGE_SIZE=100
BIDPAGE_MAX_PAGES=20
# 서버 인증서 체인이 불완전할 때 사용하는 SHA-256 인증서 지문
BIDPAGE_TLS_SHA256=
BIDPAGE_USERNAME=
BIDPAGE_PASSWORD=

# eBiz4u 공개 공고를 별도 출처로 직접 수집합니다. 로그인 정보는 필요하지 않습니다.
EBIZ4U_ENABLED=false
EBIZ4U_BASE_URL=https://www.ebiz4u.co.kr
EBIZ4U_MAX_PAGES=40
